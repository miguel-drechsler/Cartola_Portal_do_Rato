# Copie este arquivo para .env e preencha o que for usar.
# O .env fica fora do Git: nunca suba suas chaves para o GitHub.

# Só se for usar a API-Football. Sem elas, o jogo funciona normalmente.
API_FOOTBALL_KEY=
API_FOOTBALL_TEAM_ID=

# Só no servidor. Na sua máquina, pode deixar em branco.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
